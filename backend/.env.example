# Autotech backend - email settings
# Copy to backend/.env (ignored by git), fill in, and load it before starting the backend:
#   set -a; source .env; set +a; ./mvnw clean spring-boot:run -Dspring-boot.run.profiles=dev
# NEVER commit real credentials.

# --- Option A: Mailpit (default for dev/demo; nothing leaves the machine) ---
# docker compose up -d mailpit   ->  inbox at http://localhost:8025
AUTOTECH_MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- Option B: real SMTP (e.g. Gmail with an app password) ---
# AUTOTECH_MAIL_ENABLED=true
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# AUTOTECH_MAIL_FROM=your-account@gmail.com

# --- Sender and workshop data shown in emails ---
AUTOTECH_MAIL_FROM=no-reply@autotech.com
AUTOTECH_WORKSHOP_NAME=Autotech
AUTOTECH_WORKSHOP_ADDRESS=
AUTOTECH_WORKSHOP_PHONE=
# Optional links used by email buttons ("Ver cómo llegar", "Pedir turno")
AUTOTECH_WORKSHOP_MAPS_URL=
AUTOTECH_WORKSHOP_CONTACT_URL=

# --- Links inside emails point to the frontend ---
AUTOTECH_PUBLIC_URL=http://localhost:3000
# Workshop time zone (appointment times are stored in local workshop time)
AUTOTECH_TIME_ZONE=America/Argentina/Cordoba

# --- Scheduled reminders (Spring cron: sec min hour day month weekday) ---
AUTOTECH_REMINDERS_CRON=0 0 9 * * *
